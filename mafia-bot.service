[Unit]
Description=Mafia Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mafia-bot
EnvironmentFile=/home/ubuntu/mafia-bot/.env
ExecStart=/home/ubuntu/mafia-bot/venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
